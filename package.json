{
  "name": "fichas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test \"tests/*.test.mjs\"",
    "test:coverage": "node --experimental-strip-types --import ./tests/register-ts.mjs --test --experimental-test-coverage \"tests/*.test.mjs\"",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "convex": "^1.40.0",
    "html2pdf.js": "^0.14.0",
    "marked": "^18.0.4",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
